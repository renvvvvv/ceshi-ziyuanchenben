# ============================================
# 数据中心测试验证平台 - 环境变量配置
# ============================================
# 部署时复制为 .env 并修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env 文件

# PostgreSQL 数据库密码（请修改为强密码）
DB_PASSWORD=postgres123

# MiniMax API Key（用于报告 AI 错别字审核，可选，留空则该功能不可用）
MINIMAX_API_KEY=

# 前端：是否启用 Mock 数据 fallback（仅调试用，生产环境必须留空/false）
# 设为 true 时，API 失败且无本地缓存会回退到 Mock 数据；留空则显示"加载失败"
VITE_USE_MOCK_DATA=

# ============================================================
# 飞书 OAuth 登录（企业自建应用）
# ============================================================
# 在飞书开放平台创建企业自建应用后，凭证信息在"凭证与基础信息"页
FEISHU_APP_ID=                # 应用唯一标识，如 cli_xxxxx
FEISHU_APP_SECRET=            # 应用秘钥
# 飞书后台"安全设置"里必须添加此 URL（HTTP/localhost/HTTPS 均可）
FEISHU_REDIRECT_URI=http://your-server-ip/api/auth/feishu/callback
# 前端首页地址（OAuth 完成后 302 回前端）
FRONTEND_HOME=/
# 未命中部门规则的飞书用户默认角色（管理者/编辑者/阅读者）
FEISHU_DEFAULT_ROLE=阅读者
# 部门-角色映射规则 JSON 数组，部门名 includes 匹配（大小写不敏感）
# 示例：管理层→管理者、测试部→编辑者、其他→阅读者（默认）
# 不配规则时所有飞书用户都用 FEISHU_DEFAULT_ROLE
FEISHU_DEPT_ROLE_MAP=[{"department":"管理层","role":"管理者"},{"department":"测试","role":"编辑者"},{"department":"研发","role":"编辑者"}]
# 是否拉取员工部门信息做角色映射（需要 contact:user.employee + contact:department.base 权限）
# false=降级模式：跳过部门查询，所有飞书用户用 FEISHU_DEFAULT_ROLE（权限未开通时用）
# true=正常模式：按 FEISHU_DEPT_ROLE_MAP 规则映射角色（权限开通后改 true）
FEISHU_FETCH_DEPT=false
