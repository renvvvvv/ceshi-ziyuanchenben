# 数据中心测试验证平台 - 后端服务
FROM node:20-slim

WORKDIR /app

# 安装 Python3（resource_plan.py 需要）— 使用国内源加速
RUN sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null; \
    apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*

COPY server/package.json ./
RUN npm install --ignore-scripts --legacy-peer-deps

COPY server/tsconfig.json ./
COPY server/config_v7.json ./
COPY server/config_v100.json ./
COPY server/config_v100.json ./scripts/
COPY server/test6/config/config_v100.json ./test6/config/
COPY server/src/ ./src/
COPY server/scripts/ ./scripts/
COPY server/knowledge/ ./knowledge/

RUN npm run build
RUN mkdir -p /app/data /app/test6/config

# 创建非 root 用户，避免容器以 root 运行（安全加固）
RUN groupadd -r app && useradd -r -g app app && chown -R app:app /app

# entrypoint：以 root 启动修复挂载的 data 目录权限，再降权到 app 跑实际进程
# 解决 docker volume 挂载 ./data 后属主是宿主 UID（如 macOS 501）导致容器内 app 用户写不进去的问题
# 注意：这里不能用 USER app —— 否则 entrypoint 已是 app 用户，gosu 切换会 "operation not permitted"
RUN printf '#!/bin/sh\nset -e\nchown -R app:app /app/data /app/uploads 2>/dev/null || true\nexec gosu app:app "$@"\n' > /entrypoint.sh \
 && chmod +x /entrypoint.sh \
 && apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/entrypoint.sh"]

EXPOSE 3001
ENV PORT=3001 NODE_ENV=production

CMD ["node", "dist/src/index.js"]
