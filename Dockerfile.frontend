# 数据中心测试验证平台 - 前端构建
FROM node:20-slim AS builder

WORKDIR /app
COPY package.json ./
RUN npm install --ignore-scripts --legacy-peer-deps

COPY . .
RUN npx vite build

# Nginx serving
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
