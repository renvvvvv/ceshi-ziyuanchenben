# 数据中心测试验证管理平台 - 前端容器
# 改：直接 COPY 本地预构建的 dist（不在容器内 build）
# 原因：
#  1. 容器内 build 每次都会产生不同 hash（即使代码不变）
#  2. 本地 build 一致性好，hash 可预测
#  3. 避免容器内 build 失败影响部署
FROM nginx:alpine

# 直接从宿主机 COPY 预构建的 dist
COPY dist/ /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
